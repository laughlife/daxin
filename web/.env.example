# OSS 配置：只填写等号右侧。AccessKey 来自可调用 AssumeRole 的 RAM 用户。
# 正式值只保存在本地 .env；不要提交 Git 或发到聊天中。
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ROLE_ARN=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# 图片公开访问根地址：自定义域名或 Bucket 公网域名，使用 https://
ALIYUN_OSS_PUBLIC_BASE_URL=
# 上传限制：20 MiB；日期目录由后台按北京时间自动生成，不需要填写。
UPLOAD_MAX_BYTES=20971520
