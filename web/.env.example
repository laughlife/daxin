# 目标新库（应用读写；生产环境必须使用非 root 账号）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=daxin
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10

# 旧库（迁移阶段只读；不会执行写入）
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=da
LEGACY_DB_CHARSET=utf8mb4
LEGACY_DB_POOL_SIZE=4

# OSS 配置：只填写等号右侧。AccessKey 只在服务端用于生成 PostObject 表单签名。
# 正式值只保存在本地 .env；不要提交 Git 或发到聊天中。
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
# ENDPOINT 只填主机名，不带 https:// 前缀，也不带 bucket：
# 例如 oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# 图片公开访问根地址：自定义域名或 Bucket 公网域名。
# 可写 https://dxfw-oss.oss-cn-shenzhen.aliyuncs.com，也可省略协议，
# 服务端会自动补 https:// 并去掉结尾斜杠。
ALIYUN_OSS_PUBLIC_BASE_URL=
# 上传限制：20 MiB；日期目录由后台按北京时间自动生成，不需要填写。
UPLOAD_MAX_BYTES=20971520
