{
  "name": "daxin-official-site-web",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/nuxt-build.mjs build",
    "dev": "nuxt dev --host 0.0.0.0 --port 3002",
    "dev:lan": "nuxt dev --host 0.0.0.0 --port 3003",
    "dev:local": "nuxt dev --port 3002",
    "generate": "node scripts/nuxt-build.mjs generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "smoke": "node scripts/smoke-check.mjs",
    "typecheck": "nuxt typecheck",
    "test": "node --test scripts/*.test.mjs ../tools/migrate-legacy/*.test.mjs",
    "check:static": "node scripts/static-check.mjs",
    "check:browser": "node scripts/run-browser-check.mjs",
    "import:wechat-albums": "node --experimental-strip-types scripts/import-wechat-albums.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
